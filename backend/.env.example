# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DBNAME

# OpenAI (AI 질문/추천)
OPENAI_API_KEY=

# JWT 서명용 (아무 긴 랜덤 문자열, 운영에서는 반드시 비밀 유지)
JWT_SECRET=

# 배포(선택): CORS 추가 출처 (쉼표 구분)
# CORS_EXTRA_ORIGINS=https://picktalk.vercel.app

# --- 소셜 로그인 (설정 전까지 버튼에 "설정 필요" 표시) ---

# 로그인 성공 후 돌아올 프론트 페이지
# 로컬: http://localhost:3000/auth/callback
# Vercel: https://picktalk.vercel.app/auth/callback
OAUTH_FRONTEND_SUCCESS_URL=http://localhost:3000/auth/callback

# Google Cloud Console → OAuth 2.0 클라이언트
# 승인된 리디렉션 URI에 아래 GOOGLE_REDIRECT_URI 와 동일한 값 등록
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/oauth/google/callback

# Kakao Developers → 앱 → 카카오 로그인
# Redirect URI에 아래 KAKAO_REDIRECT_URI 와 동일한 값 등록
KAKAO_REST_API_KEY=
# 카카오 앱에서 Client Secret 사용 시에만 입력
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://127.0.0.1:8000/auth/oauth/kakao/callback
